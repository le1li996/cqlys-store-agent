# ============================================================
# 门店经营智脑 · 后端环境变量模板
# 复制本文件为 .env 后填入真实值（部署到平台时直接在平台的环境变量里配置即可，无需文件）。
# ============================================================

# —— 服务端口（部署平台通常会自动注入 PORT，本地可不设，默认 8787）——
PORT=8787

# —— 短信通道 ——
# dev      : 验证码仅打印到后端日志，不下发真实短信（适合本地/演示）
# tencent  : 走腾讯云短信真实下发（需同时配置下方 TENCENT_*）
SMS_PROVIDER=dev

# —— 腾讯云短信（仅 SMS_PROVIDER=tencent 时需要）——
# 控制台：https://console.cloud.tencent.com/sms
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_APP_ID=
TENCENT_SIGN_NAME=
TENCENT_TEMPLATE_ID=
# 短信地域，默认 ap-guangzhou
TENCENT_REGION=ap-guangzhou
